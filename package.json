{
  "name": "skillo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "npm run db:init",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:seed",
    "db:init": "tsx prisma/init.ts",
    "format": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"prisma/*.ts\" \"tests/**/*.ts\" \"*.{ts,mjs,json,md}\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@libsql/client": "0.15.15",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^27.0.0",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.23.1"
  }
}
