# Local MVP database. Production should use the PostgreSQL schema noted in prisma/README.md.
DATABASE_URL="file:./prisma/dev.db"

# Use a long random value in production.
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Development and review only. Set false in production and do not seed demo accounts.
DEMO_MODE="true"

# Optional. The MVP has a deterministic fallback so the core flow works without a provider.
AI_API_KEY=""
